---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BadgeSymbol from '../components/BadgeSymbol.astro';
import { cafe } from '../data/cafe';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- A preview made for Café Raya, not their official site yet. Keep it out
         of search so it can never compete with their own Facebook page.
         Remove this line only once they approve it. -->
    <meta name="robots" content="noindex, nofollow" />

    <meta name="theme-color" content="#fbf9f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Link preview on Facebook / Messenger. Their crawlers don't run JavaScript. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={cafe.name} />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Café Raya — Brewed for your best moment." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <BadgeSymbol />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Close the phone menu once a link is chosen, on a tap elsewhere, or on Escape.
      const nav = document.querySelector<HTMLDetailsElement>('details[data-nav]');
      if (nav) {
        nav.addEventListener('click', (event) => {
          if ((event.target as Element).closest('a')) nav.open = false;
        });
        document.addEventListener('click', (event) => {
          if (nav.open && !nav.contains(event.target as Node)) nav.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.open) {
            nav.open = false;
            nav.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
