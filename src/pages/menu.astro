---
import Base from '../layouts/Base.astro';
import Botanical from '../components/Botanical.astro';
import MenuSection from '../components/MenuSection.astro';
import Badge from '../components/Badge.astro';
import { menu } from '../data/menu';
---

<Base
  title="Menu — Café Raya, Cuenca"
  description="The full Café Raya menu with prices: coffee, frappes, iced drinks, fruit tea, yogurt, rice meals, snacks, pasta and waffles."
>
  <!-- The head of their drinks boards: badge, CAFÉ RAYA, "• M E N U •", script line -->
  <section class="relative overflow-hidden">
    <Botanical class="pointer-events-none absolute -top-1 -left-3 w-24 text-ink/75 sm:w-44" />
    <Botanical flip class="pointer-events-none absolute -top-1 -right-3 w-24 text-ink/75 sm:w-44" />
    <div class="relative mx-auto max-w-3xl px-6 pt-16 pb-12 text-center">
      <Badge class="mx-auto size-20 text-ink sm:size-22" />
      <h1 class="mt-5 font-display text-[2.6rem] leading-none font-semibold tracking-[0.08em] uppercase sm:text-6xl">Café Raya</h1>
      <p class="mt-4 flex items-center justify-center gap-4 text-sm font-medium tracking-[0.6em] uppercase" aria-label="Menu">
        <span class="h-px w-10 bg-ink/50" aria-hidden="true"></span>
        <span class="size-1 rounded-full bg-ink" aria-hidden="true"></span>
        <span aria-hidden="true">Menu</span>
        <span class="size-1 rounded-full bg-ink" aria-hidden="true"></span>
        <span class="h-px w-10 bg-ink/50" aria-hidden="true"></span>
      </p>
      <p class="mt-3 font-script text-2xl text-espresso sm:text-[1.75rem]">Made with love, just for you.</p>
    </div>
  </section>

  <!-- Section tabs: centred when they fit, scroll sideways when they don't (phones). -->
  <nav class="sticky top-16 z-30 border-y border-line bg-paper/95 backdrop-blur-sm" aria-label="Menu sections">
    <ul
      class="relative mx-auto flex w-max max-w-full gap-1 overflow-x-auto px-3 py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-tabs
    >
      {
        menu.map((section) => (
          <li class="shrink-0">
            <a
              href={`#${section.id}`}
              data-tab={section.id}
              class="block rounded-full px-3.5 py-2 text-[0.7rem] font-medium tracking-[0.16em] whitespace-nowrap text-ink-soft uppercase transition-colors hover:text-ink aria-[current=true]:bg-espresso aria-[current=true]:text-paper"
            >
              {section.tab ?? section.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {menu.map((section) => <MenuSection section={section} />)}

  <p class="border-t border-line bg-paper px-4 py-10 text-center text-sm text-muted">All prices in Philippine pesos.</p>
</Base>

<script>
  // Highlight the tab for whichever section is in the middle of the screen,
  // and keep that tab scrolled into view on phones.
  const list = document.querySelector<HTMLElement>('[data-tabs]');
  const tabs = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach((tab) => tabs.set(tab.dataset.tab!, tab));

  let current = '';
  function select(id: string) {
    if (id === current) return;
    current = id;
    tabs.forEach((tab, key) => {
      if (key === id) tab.setAttribute('aria-current', 'true');
      else tab.removeAttribute('aria-current');
    });
    const tab = tabs.get(id);
    if (tab && list && list.scrollWidth > list.clientWidth) {
      list.scrollTo({ left: tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2, behavior: 'smooth' });
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) select(entry.target.id);
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));
</script>
