---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
---

<Base title="Page not found — Café Raya" description="This page doesn't exist. Head back to the Café Raya menu.">
  <section class="mx-auto max-w-xl px-6 py-24 text-center sm:py-32">
    <Badge class="mx-auto size-20 text-ink" />
    <p class="mt-8 text-[0.7rem] font-medium tracking-[0.3em] text-ink-soft uppercase">Error 404</p>
    <h1 class="mt-3 font-display text-3xl font-semibold tracking-[0.08em] uppercase sm:text-4xl">Page not found</h1>
    <p class="mt-4 leading-relaxed text-ink-soft">
      The link may be mistyped, or the page has moved. The menu is still right where it was.
    </p>
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/menu" class="btn btn-dark w-full sm:w-auto">See the menu</a>
      <a href="/" class="btn btn-line w-full sm:w-auto">Back to home</a>
    </div>
  </section>
</Base>
